      <aliases enabled='yes' />
      <column caption='Neg sales' datatype='real' name='[Calculation_0511603361820672]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='-[Sales]' />
      </column>
      <column caption='Profit vs Loss' datatype='string' name='[Calculation_0691099330330624]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Profit] &gt; 0 THEN &quot;profit&quot;&#13;&#10;ELSE &quot;loss&quot;&#13;&#10;END' />
      </column>
      <column caption='Region grouping' datatype='string' name='[Calculation_0691099335098369]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Region]&#13;&#10;WHEN &quot;East&quot; THEN &quot;Zon 1&quot;&#13;&#10;WHEN &quot;West&quot; THEN &quot;Zon 1&quot;&#13;&#10;WHEN &quot;Central&quot; THEN &quot;Zon 2&quot;&#13;&#10;WHEN &quot;South&quot; THEN &quot;Zon 2&quot;&#13;&#10;END' />
      </column>
      <column caption='Discount level' datatype='string' name='[Calculation_0691099338612738]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Discount] &gt; 0.6 THEN &quot;High&quot;&#13;&#10;ELSEIF [Discount] &gt; 0.4 THEN &quot;Medium&quot;&#13;&#10;ELSE &quot;Low&quot;&#13;&#10;END' />
      </column>
      <column caption='Category type' datatype='string' name='[Calculation_0691099341987844]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Category]&#13;&#10;WHEN &quot;Furniture&quot; THEN &quot;Non tech&quot;&#13;&#10;WHEN &quot;Office Supplies&quot; THEN &quot;Non tech&quot;&#13;&#10;WHEN &quot;Technology&quot; THEN &quot;Tech&quot;&#13;&#10;END' />
      </column>
      <column caption='QUANTITY LEVEL' datatype='string' name='[Calculation_0691099345117189]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Quantity] &lt;=5 THEN &quot;Low&quot;&#13;&#10;ELSEIF [Quantity] &lt;=10 THEN &quot;Medium&quot;&#13;&#10;ELSE &quot;High&quot;&#13;&#10;END' />
      </column>
      <column caption='DELIVERY DAYS' datatype='integer' name='[Calculation_0691099347353607]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Ship Date] - [Order Date]' />
      </column>
      <column caption='Delivery speed' datatype='string' name='[Calculation_0691099347517448]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_0691099347353607] &gt; 5 THEN &quot;Delivery delayed&quot;&#13;&#10;ELSEIF [Calculation_0691099347353607] &gt; 2 THEN &quot;Normal delivery&quot;&#13;&#10;ELSE &quot;Fast delivery&quot;&#13;&#10;END' />
      </column>
      <column caption='SALES VARIATION' datatype='string' name='[Calculation_1005561407623168]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Sales] &gt;15000 THEN &quot;High sale&quot;&#13;&#10;ELSEIF [Sales] &gt;=5000 THEN &quot;Avarage sale&quot;&#13;&#10;ELSE &quot;Low&quot;&#13;&#10;END' />
      </column>
      <column datatype='string' name='[Category]' role='dimension' type='nominal' />
      <column datatype='string' name='[City]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
      <column datatype='string' name='[Country/Region]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
      <column datatype='date' name='[Order Date]' role='dimension' type='ordinal' />
