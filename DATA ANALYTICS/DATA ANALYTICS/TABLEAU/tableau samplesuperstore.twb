            </column>
            <column caption='Delivery speed' datatype='string' name='[Calculation_0691099347517448]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_0691099347353607] &gt; 5 THEN &quot;Delivery delayed&quot;&#13;&#10;ELSEIF [Calculation_0691099347353607] &gt; 2 THEN &quot;Normal delivery&quot;&#13;&#10;ELSE &quot;Fast delivery&quot;&#13;&#10;END' />
            </column>
